# OCPP Virtual Charger Farm — Configuration
# Copy this file to .env and adjust values for your setup.

# ─── Control Plane ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8086

# ─── OCPP Server URLs ──────────────────────────────────────────────────────
# WebSocket endpoint of your OCPP 1.6j CSMS
OCPP16_URL=ws://localhost:9100/ocpp

# WebSocket endpoint of your OCPP 2.0.1 CSMS
OCPP201_URL=ws://localhost:9201/ocpp

# ─── Optional Integrations ─────────────────────────────────────────────────
# CPO REST API base URL — used for session validation in generated reports
# Leave empty to skip CPO session cross-checks
CPO_API_URL=

# Redis host — used for stale charge-point key detection in reports
# Leave empty to skip Redis checks
REDIS_HOST=

# ─── Individual Charger Settings (charger.py / charger16.py / charger201.py)
# These apply when running a standalone single charger, not the farm.
OCPP_URL=ws://localhost:9100/ocpp/VIRT-001
CP_ID=VIRT-001
VENDOR=VirtualCharger
MODEL=Virtual-120kW
SERIAL=VIRT-001-SN
FIRMWARE=VIRT-1.0.0
MAX_KW=120
NUM_CONNECTORS=2
INITIAL_SOC=0
HEARTBEAT_INTERVAL=30
METER_INTERVAL=30
AUTO_START=false
RECONNECT_DELAY=5
